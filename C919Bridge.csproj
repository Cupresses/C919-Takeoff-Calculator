<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>C919.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <Product>C919 起飞性能计算器</Product>
    <Company>Fycyc C919 MSFS 2024</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsSimConnect" Version="0.2.4" />
    <PackageReference Include="CsSimConnect.Native.MSFS2024" Version="0.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="www\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
